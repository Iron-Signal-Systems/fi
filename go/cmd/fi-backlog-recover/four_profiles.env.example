# Source this file from a ROOT-owned, chmod 0600 COPY placed outside Git.
# NEVER commit real DSNs or passwords. Use .pgpass or service configuration.
# Example: set -a; . /root/fi-four-profiles.env; set +a

FI_BENCH_BINARY='/home/jwood/fi-real-backlog-20261101/fi-backlog-recover-window-profiles'
FI_BENCH_BINARY_SHA256='REPLACE_WITH_NEW_BUILD_SHA256_AFTER_GIT_PULL'
FI_BENCH_OUTPUT_ROOT='/var/tmp/fi-window-bench-NEW-UNIQUE-RUN-ID'
FI_BENCH_CUSTODY_ROOT='/var/db/fi/custody/generation'
FI_BENCH_RECORDED_ROOT='/var/db/fi/custody/recorded'
FI_BENCH_SOURCE_NAMESPACES='false'

# Four DISTINCT new PostgreSQL clusters (or independently provisioned test
# database instances) with the same FI schema, installed *private* schemas,
# and fi_ingest role. All recovery and authoritative tables MUST be empty.
# Use your actual isolated test endpoints. Do not use active fi-sor-db.
FI_BENCH_W32_DSN='host=/ABSOLUTE/PRIVATE/SOCKET/W32 port=PLACEHOLDER user=fi_ingest dbname=fi sslmode=disable'
FI_BENCH_W64_DSN='host=/ABSOLUTE/PRIVATE/SOCKET/W64 port=PLACEHOLDER user=fi_ingest dbname=fi sslmode=disable'
FI_BENCH_W96_DSN='host=/ABSOLUTE/PRIVATE/SOCKET/W96 port=PLACEHOLDER user=fi_ingest dbname=fi sslmode=disable'
FI_BENCH_W128_DSN='host=/ABSOLUTE/PRIVATE/SOCKET/W128 port=PLACEHOLDER user=fi_ingest dbname=fi sslmode=disable'

# Set to YES only after verifying that all four targets are disposable
# isolated instances, NOT merely four differently spelled DSNs to fi-sor-db.
FI_BENCH_ISOLATED_CLUSTERS_CONFIRMED='NO'
