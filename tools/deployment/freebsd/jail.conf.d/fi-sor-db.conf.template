fi-sor-db {
    path = "@FI_SOR_DB_ROOT@";
    host.hostname = "fi-sor-db";

    persist;
    vnet;
    vnet.interface = "@FI_SOR_DB_MGMT_JAIL_IF@", "@FI_SOR_DB_WORK_JAIL_IF@";

    mount.fstab = "@FI_SOR_DB_FSTAB@";
    mount.devfs;
    devfs_ruleset = @FI_DEVFS_RULESET@;

    children.max = 0;
    enforce_statfs = 2;

    allow.nomount;
    allow.noraw_sockets;

    exec.clean;
}
